{
    "name": "queencitycodefactory/butter-cream",
    "description": "Butter Cream - A CakePHP Bootstrap 5 Theme/Plugin",
    "type": "cakephp-plugin",
    "keywords": ["cakephp", "plugin", "bootstrap", "theme", "front-end"],
    "homepage": "https://github.com/QueenCityCodeFactory/butter-cream",
    "license": "MIT",
    "authors": [
        {
            "name": "Willetts Tech",
            "homepage": "https://www.willettstech.com/"
        }
    ],
    "require": {
        "php": ">=8.4",
        "cakephp/cakephp": "^5.3",
        "friendsofcake/search": "^7.0.0",
        "friendsofcake/bootstrap-ui" : "^5.0.0",
        "friendsofcake/cakepdf": "^5.0.0",
        "queencitycodefactory/cakespreadsheet": "dev-cake-5.x"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.1",
        "cakephp/bake": "^3.0",
        "cakephp/cakephp-codesniffer": "^5.1",
        "phpstan/phpstan": "^2.0"
    },
    "support": {
        "issues": "https://github.com/QueenCityCodeFactory/butter-cream/issues",
        "source": "https://github.com/QueenCityCodeFactory/butter-cream"
    },
    "autoload": {
        "psr-4": {
            "ButterCream\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "ButterCream\\Test\\": "tests"
        }
    },
    "scripts": {
        "check": [
            "@test",
            "@cs-check",
            "@stan"
        ],
        "cs-check": "phpcs -p --standard=vendor/cakephp/cakephp-codesniffer/CakePHP src/",
        "cs-fix": "phpcbf --standard=vendor/cakephp/cakephp-codesniffer/CakePHP src/",
        "stan": "phpstan analyse",
        "psalm": "psalm",
        "test": "phpunit"
    }
}
