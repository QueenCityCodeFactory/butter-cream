parameters:
    level: 8
    checkMissingIterableValueType: false
    checkGenericClassInNonGenericObjectType: false
    treatPhpDocTypesAsCertain: false
    bootstrapFiles:
        - tests/bootstrap.php
    paths:
        - src
    ignoreErrors:
        # Allow dynamic property access in TrustProxyMiddleware
        - '#Access to an undefined property Psr\\Http\\Message\\ServerRequestInterface::\$trustProxy#'
