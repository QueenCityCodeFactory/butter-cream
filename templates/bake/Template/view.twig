{% set associations = {'BelongsTo': [], 'HasOne': [], 'HasMany': [], 'BelongsToMany': []}|merge(associations) %}
{% set fieldsData = Bake.getViewFieldsData(fields, schema, associations) %}
{% set associationFields = fieldsData.associationFields %}
{% set groupedFields = fieldsData.groupedFields %}
{% set pK = '$' ~ singularVar ~ '->' ~ primaryKey[0] %}
<?php
    /**
    * @var \{{ namespace }}\View\AppView $this
    * @var \{{ entityClass }} ${{ singularVar }}
    */
    $this->extend('ButterCream./layout/view');
    $this->assign('page.heading', '{{ singularHumanName }}');
    $this->start('view.card.buttons');
?>
<div class="btn-group btn-group-xs" role="group" aria-label="Actions">
    <?= $this->Html->actionDropdownMenu([
        $this->Html->link('Edit {{ singularHumanName }}', ['action' => 'edit', {{ pK|raw }}], ['class' => 'dropdown-item']),
        $this->Html->link('List {{ pluralHumanName }}', ['action' => 'index'], ['class' => 'dropdown-item']),
        $this->Html->link('New {{ singularHumanName }}', ['action' => 'add'], ['class' => 'dropdown-item']),
{% set done = [] %}
{% for type, data in associations %}
{% for alias, details in data %}
{% if details.controller is not same as(_view.name) and details.controller not in done %}
        $this->Html->link('List {{ alias|underscore|humanize }}', ['controller' => '{{ details.controller }}', 'action' => 'index'], ['class' => 'dropdown-item']),
        $this->Html->link('New {{ alias|underscore|singularize|humanize }}', ['controller' => '{{ details.controller }}', 'action' => 'add'], ['class' => 'dropdown-item']),
{% set done = done|merge(['controller']) %}
{% endif %}
{% endfor %}
{% endfor %}
    ]) ?>
</div>
<?php $this->end(); ?>

{% set relations = associations.BelongsToMany|merge(associations.HasMany) %}
{% if relations %}
<?php $this->start('related_data');
{% for alias, details in relations %}
{% set otherSingularVar = alias|variable %}
{% set domId = details.controller|underscore|humanize|lower|slug %}
    echo $this->Ajax->relatedData('{{ domId }}-pagination', ['controller' => '{{ details.controller }}', 'action' => 'index', '?' => ['{{ details.foreignKey }}' => {{ pK|raw }}]]);
{% endfor %}
$this->end(); ?>
{% endif %}
<div class="row">
{% if groupedFields['string'] %}
    <div class="col-lg-5">
        <dl class="row mb-0">
{% for field in groupedFields['string'] %}
{% if associationFields[field] %}
{% set details = associationFields[field] %}
            <dt class="col-sm-4">{{ details.property|humanize }}</dt>
            <dd class="col-sm-8"><?= ${{ singularVar }}->{{ details.property }} ? $this->Html->link(${{ singularVar }}->{{ details.property }}->{{ details.displayField }} ?? '', ['controller' => '{{ details.controller }}', 'action' => 'view', ${{ singularVar }}->{{ details.property }}->{{ details.primaryKey[0] }}]) : '<span class="text-muted">&mdash;</span>' ?></dd>
{% else %}
            <dt class="col-sm-4">{{ field|humanize }}</dt>
            <dd class="col-sm-8"><?= $this->Html->nullSafe(h(${{ singularVar }}->{{ field }})) ?></dd>
{% endif %}
{% endfor %}
        </dl>
    </div>
{% endif %}
{% if groupedFields.number %}
    <div class="col-lg-2">
        <dl class="row mb-0">
{% for field in groupedFields.number %}
            <dt class="col-sm-6">{{ field|humanize }}</dt>
            <dd class="col-sm-6"><?= ${{ singularVar }}->{{ field }} !== null ? $this->Number->format(${{ singularVar }}->{{ field }}) : '<span class="text-muted">&mdash;</span>' ?></dd>
{% endfor %}
        </dl>
    </div>
{% endif %}
{% if groupedFields.date %}
    <div class="col-lg-3">
        <dl class="row mb-0">
{% for field in groupedFields.date %}
            <dt class="col-sm-6">{{ field|humanize }}</dt>
            <dd class="col-sm-6"><?= $this->Html->nullSafe($this->Time->userFormat(${{ singularVar }}->{{ field }})) ?></dd>
{% endfor %}
        </dl>
    </div>
{% endif %}
{% if groupedFields.boolean %}
    <div class="col-lg-2">
        <dl class="row mb-0">
{% for field in groupedFields.boolean %}
            <dt class="col-sm-6">{{ field|humanize }}</dt>
            <dd class="col-sm-6"><?= $this->Badge->boolean(${{ singularVar }}->{{ field }}) ?></dd>
{% endfor %}
        </dl>
    </div>
{% endif %}
</div>
{% if groupedFields.text %}
{% for field in groupedFields.text %}
<div class="row mt-3">
    <div class="col-lg-12">
        <h6>{{ field|humanize }}</h6>
        <?= ${{ singularVar }}->{{ field }} !== null ? $this->Text->autoParagraph(h(${{ singularVar }}->{{ field }})) : '<p class="text-muted">&mdash;</p>' ?>
    </div>
</div>
{% endfor %}
{% endif %}
